<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="unset_orders_wzrd" model="ir.ui.view">
            <field name="name">Unset Orders</field>
            <field name="model">unset.orders.wzrd</field>
            <field name="arch" type="xml">
                <form string="Unset Orders">
                        <group>
                            <field name="name"/>
                        </group>
                        <footer>
                        <button name="create_orders_from_json" string="Return" type="object" class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="unset_orders_wzrd_action" model="ir.actions.act_window">
            <field name="name">Unset Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">unset.orders.wzrd</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <!-- This Menu Item must have a parent and an action
        <menuitem id="unset_orders_wzrd_menu" name="POS Unset Orders" parent="point_of_sale.menu_point_config_product" action="unset_orders_wzrd_action" sequence="40"/>
-->

    </data>
</openerp>